{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aktool.local/schemas/1.0.0/bosch_dtc.schema.json",
  "title": "AKTOOL bosch_dtc",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json"
    }
  ],
  "required": [
    "dtc_code",
    "encoding_profile",
    "dtc_record_index",
    "start_file_offset",
    "mask_table",
    "error_path_table",
    "relationship_validation"
  ],
  "properties": {
    "category": {
      "const": "bosch_dtc"
    },
    "dtc_code": {
      "$ref": "#/$defs/dtc_code"
    },
    "encoding_profile": {
      "type": "string",
      "minLength": 1
    },
    "dtc_record_index": {
      "type": "integer",
      "minimum": 0
    },
    "start_file_offset": {
      "type": "integer",
      "minimum": 0
    },
    "mask_table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table_entry_base",
        "unevaluatedProperties": false
      }
    },
    "error_path_table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table_entry_base",
        "unevaluatedProperties": false
      }
    },
    "relationship_validation": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unverified",
            "conflict"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "proposed_strategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_bytes": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/hex_bytes"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "dtc_code": {
      "type": "string",
      "pattern": "^[PCBU][0-9A-F]{4}([0-9A-F]{2})?$"
    },
    "table_entry_base": {
      "type": "object",
      "required": [
        "table_base_file_offset",
        "entry_index",
        "entry_file_offset",
        "entry_size",
        "original_bytes",
        "relation_to_dtc",
        "evidence"
      ],
      "properties": {
        "table_base_file_offset": {
          "type": "integer",
          "minimum": 0
        },
        "table_base_ecu_address": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entry_index": {
          "type": "integer",
          "minimum": 0
        },
        "entry_file_offset": {
          "type": "integer",
          "minimum": 0
        },
        "entry_ecu_address": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entry_size": {
          "type": "integer",
          "minimum": 1
        },
        "original_bytes": {
          "$ref": "common.schema.json#/$defs/hex_bytes"
        },
        "decoded_value": {
          "type": [
            "integer",
            "number",
            "string",
            "null"
          ]
        },
        "bit_meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_to_dtc": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          }
        }
      }
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "unevaluatedProperties": false
}
